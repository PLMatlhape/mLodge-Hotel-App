# Backend Environment Variables for Render Production
# Copy this file and configure in Render Dashboard > Environment

# Server Configuration
PORT=3001
NODE_ENV=production

# Database Configuration (Get from Render PostgreSQL)
# Go to your Render PostgreSQL instance > Connect > External Connection
DB_HOST=<your-render-postgres-hostname>
DB_PORT=5432
DB_USER=<your-render-postgres-username>
DB_PASSWORD=<your-render-postgres-password>
DB_NAME=<your-render-postgres-database>

# JWT Secret (Generate a secure random string)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=<your-secure-jwt-secret-here>
JWT_EXPIRES_IN=7d

# Admin Default Credentials
ADMIN_EMAIL=Admin@mlodgehotel.co.za
ADMIN_PASSWORD=Admin@mlodgehotel

# CORS Settings (Your Vercel frontend URL - NO trailing slash)
CORS_ORIGIN=https://mlodge-hotel-app-steel.vercel.app

# File Upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880

# Optional: Email Configuration (if using email features)
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
